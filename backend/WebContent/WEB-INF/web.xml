<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Saarthi</display-name>

    <!-- Servlets are annotation-based (@WebServlet). Filters are also annotated,
         but declared here explicitly too: annotation discovery order is not
         guaranteed by the servlet spec, and CorsFilter MUST run before AuthFilter
         so 401 responses and OPTIONS preflights still carry CORS headers. -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.saarthi.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.saarthi.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- SPA fallback: all 404s that are not API/asset requests serve index.html
         so React Router can handle client-side routes like /login, /dashboard etc. -->
    <error-page>
        <error-code>404</error-code>
        <location>/index.html</location>
    </error-page>

</web-app>
